#ifndef INSTRS_H
#define INSTRS_H
#include <iss/arch/traits.h>
#include <core.h>
#include <iss/instruction_decoder.h>

constexpr std::array<iss::generic_instruction_descriptor, ${instructions.size()}> eve_instr_info{{
        <%instructions.each{instr -> %>
        {${instr.encoding}, ${instr.mask}, iss::arch::traits<eve_core>::opcode_e::${instr.instruction.name}},<%}%>
    }};
#endif
