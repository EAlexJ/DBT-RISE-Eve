Core eve_core{
    architectural_state {
        register unsigned<8> REG[8] [[is_main_reg]];
        unsigned<8>& A = REG[0];
        unsigned<8>& B = REG[1];
        unsigned<8>& C = REG[2];
        unsigned<8>& D = REG[3];
        unsigned<8>& X = REG[4];
        unsigned<8>& Y = REG[5];
        unsigned<8>& M1 = REG[6];
        unsigned<8>& M2 = REG[7];

        register unsigned<16> PC [[is_pc]];
        register unsigned<16> SP;

        register unsigned<1> FLAGS[4];
        unsigned<1>& CY = FLAGS[0];
        unsigned<1>& SN = FLAGS[1];
        unsigned<1>& ZE = FLAGS[2];
        unsigned<1>& OV = FLAGS[3];

        extern unsigned<8> IMEM[0xfff];
        extern unsigned<8> DMEM[0xffff];
    }

    functions{
        extern void eve_out(unsigned<8> port, unsigned<8> val);
        extern unsigned<8> eve_in();
        void set_SN_ZE(unsigned<8> res){
            SN = (res & 0x80) != 0;
            ZE = res == 0;
        }
    }

    instructions {
        MOV {
            encoding: 2'b01 :: regS[2:0] :: regD[2:0];
            assembly: "{name(regD)} = {name(regS)}";
            behavior: REG[regD] = REG[regS];
        }

        LD {
            encoding: 5'b10000 :: reg[2:0] :: imm[15:0];
            assembly: "{name(reg)} = [{imm:#0x}]";
            behavior: REG[reg] = DMEM[imm];
        }

        ST {
            encoding: 5'b10001 :: reg[2:0] :: imm[15:0];
            assembly: "[{imm:#0x}] = {name(reg)}";
            behavior: DMEM[imm]  = REG[reg]; 
        }

        PUSH {
            encoding: 5'b10010 :: reg[2:0];
            assembly: "push {name(reg)}";
            behavior: {
                SP = (unsigned<16>)(SP - 1);
                DMEM[SP] = REG[reg];
            }
        }

        POP {
            encoding: 5'b10011 :: reg[2:0];
            assembly: "pop {name(reg)}";
            behavior: {
                REG[reg] = DMEM[SP];
                SP = (unsigned<16>)(SP + 1);
            }
        }
        MOVI {
            encoding: 5'b10100 :: reg[2:0] :: imm[7:0];
            assembly: "{name(reg)} = {imm:#0x}";
            behavior: REG[reg] = imm;
        }

        ADD16 {
            encoding: 5'b10101 :: regS[1:0] :: regD[0:0] :: imm[15:0];
            assembly: "{add16_asm(regS, regD, imm)}";
            behavior: {
                unsigned<16> res = imm;
                if(regS == 2'b00)
                    res = (unsigned<16>)(imm + (X :: Y));
                else if(regS == 2'b01)
                    res = (unsigned<16>)(imm + (M1 :: M2));
                else if(regS ==2'b11)
                    res = (unsigned<16>)(imm + A);
                if(regD == 0){
                    X = res[15:8];
                    Y = res[7:0];
                } 
                else if(regD == 1){
                    M1 = res[15:8];
                    M2 = res[7:0];
                }
            }
        }

        AND {
            encoding: 8'b10110000;
            assembly: "A = A & B";
            behavior: {
                unsigned<8> res = A & B;
                set_SN_ZE(res);
                CY = 0;
                OV = 0;
                A = res;
            }
        }

        OR {
            encoding: 8'b10110001;
            assembly: "A = A | B";
            behavior: {
                unsigned<8> res = A | B;
                set_SN_ZE(res);
                CY = 0;
                OV = 0;
                A = res;
            }
        }

        XOR {
            encoding: 8'b10110010;
            assembly: "A = A ^ B";
            behavior: {
                unsigned<8> res = A ^ B;
                set_SN_ZE(res);
                CY = 0;
                OV = 0;
                A = res;
            }
        }

        NOT {
            encoding: 8'b10110011;
            assembly: "A = !A";
            behavior: {
                unsigned<8> res = !A;
                set_SN_ZE(res);
                CY = 0;
                OV = 0;
                A = res;
            }
        }

        ADD {
            encoding: 8'b10110100;
            assembly: "A = A + B";
            behavior: {
                unsigned<9> res = A + B;
                set_SN_ZE((unsigned<8>)res);
                CY = res > 0xFF;
                OV = (signed<8>)A > 0 && (signed<8>)B > 0 && (signed<8>)res < 0 ||
                     (signed<8>)A < 0 && (signed<8>)B < 0 && (signed<8>)res > 0;
                A = (unsigned<8>)res;
            }
        }

        ADDC {
            encoding: 8'b10110101;
            assembly: "A = A + B + CY";
            behavior: {
                unsigned<10> res = A + B + CY;
                set_SN_ZE((unsigned<8>)res);
                CY = res > 0xFF;
                OV = (signed<8>)A > 0 && (signed<8>)B > 0 && (signed<8>)res < 0 ||
                     (signed<8>)A < 0 && (signed<8>)B < 0 && (signed<8>)res > 0;
                A = (unsigned<8>)res;
            }
        }

        SUB {
            encoding: 8'b10110110;
            assembly: "A = A - B";
            behavior: {
                signed<9> res = A - B;
                set_SN_ZE((unsigned<8>)res);
                CY = res < 0;
                OV = (((A ^ B) & 0x80) && ((A ^ res) & 0x80));
                A = (unsigned<8>)res;
            }
        }

        SUBC {
            encoding: 8'b10110111;
            assembly: "A = A - B - CY";
            behavior: {
                signed<10> res = A - B - CY;
                set_SN_ZE((unsigned<8>)res);
                CY = res < 0;
                OV = (((A ^ B) & 0x80) && ((A ^ res) & 0x80));
                A = (unsigned<8>)res;
            }
        }

        NEG {
            encoding: 8'b10111000;
            assembly: "A = -A";
            behavior: {
                signed<9> res = -A;
                set_SN_ZE((unsigned<8>)res);
                CY = 0;
                OV = (unsigned<1>)(A & 0x80);
                A = (unsigned<8>)res;
            }
        }

        CLR {
            encoding: 8'b10111001;
            assembly: "A = 0";
            behavior: {
                SN = 0;
                ZE = 1;
                CY = 0;
                OV = 0;
                A = 0;
            }
        }

        SHL {
            encoding: 8'b10111010;
            assembly: "A = A << 1";
            behavior: {
                unsigned<9> res = A << 1;
                set_SN_ZE((unsigned<8>)res);
                CY = (unsigned<1>)(res & 0x100);
                OV = 0;
                A = (unsigned<8>) res;
            }
        }

        SHLC {
            encoding: 8'b10111011;
            assembly: "A = A <<< 1";
            behavior: {
                unsigned<9> res = A :: CY;
                set_SN_ZE((unsigned<8>)res);
                CY = (unsigned<1>)(res & 0x100);
                OV = 0;
                A = (unsigned<8>)res;
            }
        }

        SHR {
            encoding: 8'b10111100;
            assembly: "A = A >> 1";
            behavior: {
                unsigned<8> res = A >> 1;
                SN = 0;
                ZE = res == 0;
                CY = (unsigned<1>)A;
                OV = 0;
                A = res;
            }
        }

        SHRC {
            encoding: 8'b10111011;
            assembly: "A = A >>> 1";
            behavior: {
                unsigned<9> res = (CY :: A) >> 1;
                set_SN_ZE((unsigned<8>)res);
                CY = (unsigned<1>)A;
                OV = 0;
                A = (unsigned<8>)res;
            }
        }

        INCR {
            encoding: 8'b10111110;
            assembly: "A = A + 1";
            behavior: {
                unsigned<9> res = A + 1;
                set_SN_ZE((unsigned<8>)res);
                CY = 0;
                OV = 0;
                A = (unsigned<8>)res;
            }
        }

        DEC {
            encoding: 8'b10111111;
            assembly: "A = A - 1";
            behavior: {
                signed<9> res = A - 1;
                set_SN_ZE((unsigned<8>)res);
                CY = 0;
                OV = 0;
                A = (unsigned<8>)res;                
            }
        }

        LDSP {
            encoding: 8'b11000000 :: imm[15:0];
            assembly: "SP = {imm:#0x}";
            behavior: SP = imm;
        }

        LDCODE {
            encoding: 8'b11000001;
            assembly: "A = code[XY]";     
            behavior: {
                unsigned<16> read_addr = X :: Y;
                A = IMEM[read_addr];
            }
        }

        GOTOXY {
            encoding: 8'b11000010;
            assembly: "goto XY";
            behavior: PC = X :: Y;
        }

        CALL {
            encoding: 8'b11000011 :: addr[15:0];
            assembly: "call {addr:#0x}";
            behavior: {
                unsigned<16> ret_addr = (unsigned<16>)(PC + 3);
                SP = (unsigned<16>)(SP - 2);
                DMEM[SP] = (unsigned<8>)(ret_addr >> 8);
                DMEM[SP+1] = (unsigned<8>)ret_addr;
                PC = addr;
            }
        }

        RET {
            encoding: 8'b11000100;
            assembly: "ret";
            behavior: {
                unsigned<8> msb_addr = DMEM[SP];
                unsigned<8> lsb_addr = DMEM[SP+1];
                SP = (unsigned<16>)(SP + 2);
                PC = msb_addr :: lsb_addr;
            }
        }

        IN {
            encoding: 8'b11000101 :: port[7:0];
            assembly: "A = in {port:#0x}";
            behavior: A = eve_in();
        }

        OUT {
            encoding: 8'b11000110 :: port[7:0];
            assembly: "out {port:#0x} = A";
            behavior: eve_out(port, A);
        }
        
        LDM {
            encoding: 8'b11000111 :: imm[15:0];
            assembly: "{ldm_asm(imm)}";
            behavior: {
                unsigned<16> read_addr = (unsigned<16>)((M1 :: M2) + imm);
                A = DMEM[read_addr];
            }
        }

        STM {
            encoding: 8'b11001000 :: imm[15:0];
            assembly: "{stm_asm(imm)}";
            behavior: {
                unsigned<16> write_addr = (unsigned<16>)((M1 :: M2) + imm);
                DMEM[write_addr] = A;                
            }
        }

        CMP {
            encoding: 8'b11001001;
            assembly: "cmp A : B";
            behavior: {
                signed<9> res = A - B;
                set_SN_ZE((unsigned<8>)res);
                CY = res < 0;
                OV = (((A ^ B) & 0x80) && ((A ^ res) & 0x80));
            }
        }

        BRANCH {
            encoding: 4'b1101 :: cond[3:0] :: addr[15:0];
            assembly: "{branch_asm(cond, addr)}";
            behavior: {
                if(cond == 4'b0000){
                    if(ZE) PC = addr;
                }
                else if(cond == 4'b0001){
                    if(!ZE) PC = addr;
                }
                else if(cond == 4'b0010){
                    if(SN^OV) PC = addr;
                }
                else if(cond == 4'b0011){
                    if((SN^OV) | ZE) PC = addr;
                }
                else if(cond == 4'b0100){
                    if((SN==OV) & !ZE) PC = addr;
                }
                else if(cond == 4'b0101){
                    if(SN==OV) PC = addr;
                }
                else if(cond == 4'b0110){
                    if(CY) PC = addr;
                }
                else if(cond == 4'b0111){
                    if(CY|ZE) PC = addr;
                }
                else if(cond == 4'b1000){
                    if(!(CY|ZE)) PC = addr;
                }
                else if(cond == 4'b1001){
                    if(!CY) PC = addr;
                }
                else if(cond == 4'b1010){
                    if(!SN) PC = addr;
                }
                else if(cond == 4'b1011){
                    if(SN) PC = addr;
                }
                else if(cond == 4'b1100){
                    if(!OV) PC = addr;
                }
                else if(cond == 4'b1101){
                    if(OV) PC = addr;
                }
                else if(cond == 4'b1110)
                    PC = addr;
            }
        }

        NOP {
            encoding: 8'b00000000;
            assembly: "nop";
            behavior: {}
        }
    }
}